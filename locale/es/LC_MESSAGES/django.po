# ── home_page.html — FAQ ──
msgid "Frequently Asked Questions"
msgstr "Preguntas Frecuentes"

msgid "Do you service commercial appliances?"
msgstr "¿Reparan electrodomésticos comerciales?"

msgid ""
"Yes, we service both commercial and residential appliances. Our technicians "
"are certified to work on industrial-grade equipment and standard home "
"appliances."
msgstr ""
"Si, reparamos electrodomésticos comerciales y residenciales. Nuestros "
"técnicos están certificados para trabajar con equipos de grado industrial y "
"electrodomésticos estándar del hogar."

msgid "Is there a warranty on repairs?"
msgstr "¿Hay garantía en las reparaciones?"

msgid ""
"All repairs come with a warranty on parts and labor. If you experience any "
"issues within the warranty period, we will fix it at no additional cost."
msgstr ""
"Todas las reparaciones incluyen garantía en piezas y mano de obra. Si "
"experimentas algún problema dentro del periodo de garantía, lo repararemos "
"sin costo adicional."

msgid "What areas do you cover?"
msgstr "¿Qué áreas cubren?"

#, python-format
