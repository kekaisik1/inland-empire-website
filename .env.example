# Required in production
SECRET_KEY=change-me-generate-a-long-random-value
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required unless Railway supplies RAILWAY_PUBLIC_DOMAIN automatically
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Railway/proxy runtime (RAILWAY_PUBLIC_DOMAIN and PORT are Railway-provided)
DJANGO_SETTINGS_MODULE=mysite.settings.production
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_ENVIRONMENT=
PORT=8000
TRUST_PROXY_HEADERS=false
RUN_STARTUP_SEEDS=false
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=60
WEB_CONCURRENCY=

# Target identity and booking/contact integration
BUSINESS_NAME=Inland Empire Appliance Repair
WAGTAILADMIN_BASE_URL=https://your-domain.example
BOOKING_URL=
BOOKING_DOMAIN=
CONTACT_EMAIL=

# Optional durable media. REDIS_URL requires the separately approved Python Redis client.
REDIS_URL=
CLOUDINARY_URL=

# Optional SMTP email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional first-party tracking (disabled by default)
TRACKING_ENABLED=false
TRACKING_WEBHOOK_ENABLED=false
TRACKING_REQUIRE_CONSENT=true
TRACKING_REQUIRE_ORIGIN=true
TRACKING_ALLOWED_ORIGINS=
TRACKING_SECRET=
TRACKING_IP_HASH_KEY=
TRACKING_COLLECT_RATE=30/m
TRACKING_WEBHOOK_RATE=10/m
TRACKING_RETENTION_DAYS=90
TRACKING_CONVERTED_RETENTION_DAYS=180
TRACKING_ADMIN_ENABLED=true

# Optional VAPI ZIP tool (disabled by default)
VAPI_ENABLED=false
VAPI_ALLOW_UNSIGNED=false
VAPI_SERVER_SECRET=
VAPI_RATE=30/m

# Optional discovery, proxy, logging, and error monitoring
BING_SITE_AUTH_TOKEN=
TRUSTED_PROXY_CIDRS=
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Optional one-time superuser bootstrap; set all three together, then remove them
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Local docker-compose only
POSTGRES_DB=inland
POSTGRES_USER=inland
POSTGRES_PASSWORD=change-me-local-only
